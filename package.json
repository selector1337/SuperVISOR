{
  "name": "supervisor",
  "version": "1.3.1",
  "description": "SuperVISOR: gestor de equipes com WhatsApp, agendamentos, conversas, contatos e estatisticas.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "browser:install": "puppeteer browsers install chrome",
    "check:whatsapp": "node scripts/check-whatsapp.cjs",
    "test:whatsapp": "node --test scripts/whatsapp-*.test.cjs",
    "postinstall": "npm run browser:install",
    "build:demo-ui": "node scripts/build-demo-frontend.cjs",
    "test:integrations": "node scripts/test-integrations-admin.cjs",
    "test:gum-receiver": "node scripts/test-gum-receiver.cjs",
    "test:conversation-composer": "node scripts/test-conversation-composer.cjs",
    "pm2:start": "pm2 startOrReload ecosystem.config.cjs --update-env",
    "start": "node src/server.js",
    "dev": "node src/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "ffmpeg-static": "^5.3.0",
    "mongodb": "^6.12.0",
    "puppeteer": "24.38.0",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "whatsapp-web.js": "1.34.8"
  }
}
